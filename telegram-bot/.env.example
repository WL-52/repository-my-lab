# Скопируйте этот файл в .env и заполните значениями.
# Файл .env в репозиторий НЕ коммитим (см. .gitignore).

# Токен бота, полученный у @BotFather в Telegram.
BOT_TOKEN=000000000:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# chat_id преподавателя — узнать его можно так:
#   1) попросить препода написать @userinfobot в Telegram;
#   2) или временно поставить TEACHER_CHAT_ID=0 и в логах бота посмотреть
#      update.effective_chat.id, когда препод напишет вашему боту /start.
TEACHER_CHAT_ID=123456789

# Список предметов через запятую (опционально).
SUBJECTS=Программирование,Математика,Английский,История,Базы данных
